# ============================================================
# PUBLIC DIRECTORY - USER UPLOADED FILES
# ============================================================
# Ignore semua file yang di-upload oleh user melalui aplikasi
# untuk menghindari file besar dan data sensitif masuk ke repository

# Storage symlink dan semua kontennya (SUDAH DI-IGNORE DI ATAS)
# /public/storage sudah di-ignore di line 5

# User uploaded files di public directory
/public/uploads/
/public/storage/avatars/*
!/public/storage/avatars/.gitkeep
/public/storage/logos/*
